{
  "name": "agent-harness-builder",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "concurrently --names ui,server --prefix-colors blue,green \"pnpm --filter @agent-harness/ui dev\" \"pnpm --filter @agent-harness/server dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "~5.7.0"
  }
}
